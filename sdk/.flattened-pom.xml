<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zextras.carbonio.quarkus</groupId>
    <artifactId>carbonio-quarkus-extensions-sdk-parent</artifactId>
    <version>1.8.2-1</version>
    <relativePath/>
  </parent>

  <groupId>com.zextras.carbonio.preview</groupId>
  <artifactId>carbonio-preview-ce-grpc-sdk</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>Carbonio Preview CE - gRPC SDK</name>

  <properties>
    <revision>0.0.0</revision>
    <changelist>-SNAPSHOT</changelist>
  </properties>

  <repositories>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras public maven repo</name>
      <url>https://zextras.jfrog.io/artifactory/java-sdk</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Runtime channel transport (plaintext ManagedChannel) -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Health check stub (grpc.health.v1) -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-services</artifactId>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
