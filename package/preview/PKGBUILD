build__ubuntu_jammy() {
  pip3 install \
    --prefix="${pkgdir}/opt/zextras/common" \
    -r requirements.txt

  python3 setup.py install \
    --no-compile \
    --prefix=/opt/zextras/common \
    --root="${pkgdir}"

  install -Dm755 "${srcdir}/carbonio-preview-start.sh.in" \
    "${pkgdir}/usr/bin/carbonio-preview-start.sh"
  sed -i "s/PYTHON_VER/3.10/g" \
    "${pkgdir}/usr/bin/carbonio-preview-start.sh"
  sed -i "s/PREFIX/common\/local/g" \
    "${pkgdir}/usr/bin/carbonio-preview-start.sh"
}

build__ubuntu_noble() {
  pip3 install \
    --prefix="${pkgdir}/opt/zextras/common" \
    -r requirements.txt

  python3 setup.py install \
    --no-compile \
    --prefix=/opt/zextras/common \
    --root="${pkgdir}"

  install -Dm755 "${srcdir}/carbonio-preview-start.sh.in" \
    "${pkgdir}/usr/bin/carbonio-preview-start.sh"
  sed -i "s/PYTHON_VER/3.12/g" \
    "${pkgdir}/usr/bin/carbonio-preview-start.sh"
  sed -i "s/PREFIX/common\/local/g" \
    "${pkgdir}/usr/bin/carbonio-preview-start.sh"
  sed -i "s/UBUNTU24/true/g" "${pkgdir}/usr/bin/carbonio-preview-start.sh"
}

