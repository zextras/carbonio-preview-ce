_build_go_ce() {
  local pkgconfig_dir="$1"

  # Go source is at the workspace root (3 levels up from srcdir = package/preview/src/)
  local workspace="${srcdir}/../../.."

  wget https://go.dev/dl/go1.25.11.linux-amd64.tar.gz -O /tmp/go.tar.gz
  rm -rf /usr/local/go
  tar -C /usr/local -xzf /tmp/go.tar.gz

  mkdir -p "${srcdir}/pdfium"
  tar -xzf "${srcdir}/pdfium-linux-x64.tgz" -C "${srcdir}/pdfium"

  mkdir -p "${pkgconfig_dir}"
  cat > "${pkgconfig_dir}/pdfium.pc" <<EOF
prefix=${srcdir}/pdfium
libdir=${srcdir}/pdfium/lib
includedir=${srcdir}/pdfium/include
Name: PDFium
Description: PDFium library
Version: 7881
Libs: -L${srcdir}/pdfium/lib -lpdfium
Cflags: -I${srcdir}/pdfium/include
EOF

  export GOROOT=/usr/local/go
  export PATH=/usr/local/go/bin:$PATH
  export GOMODCACHE="${srcdir}/.gomodcache"
  export GOFLAGS="-mod=mod"
  export GOPRIVATE="github.com/zextras/*"
  export GOTOOLCHAIN=local
  export CGO_ENABLED=1
  export PKG_CONFIG_PATH="${pkgconfig_dir}:/usr/lib/x86_64-linux-gnu/pkgconfig"
  export CGO_LDFLAGS="-Wl,-rpath,/usr/lib/carbonio-preview"

  go version

  cd "${workspace}"
  go mod download
  go build -ldflags="-s -w" -o "${srcdir}/carbonio-preview-bin" ./cmd/carbonio-preview/...
  cp "${srcdir}/pdfium/lib/libpdfium.so" "${srcdir}/libpdfium.so"
}

build__ubuntu_focal() {
  _build_go_ce /usr/lib/pkgconfig
}

build__ubuntu_jammy() {
  _build_go_ce /usr/lib/pkgconfig
}

build__ubuntu_noble() {
  _build_go_ce /usr/lib/pkgconfig
}

build__rocky_8() {
  _build_go_ce /usr/lib64/pkgconfig
}

build__rocky_9() {
  _build_go_ce /usr/lib64/pkgconfig
}

package() {
  install -Dm755 "${srcdir}/carbonio-preview" \
    "${pkgdir}/usr/bin/carbonio-preview"
  install -Dm755 "${srcdir}/carbonio-preview-bin" \
    "${pkgdir}/usr/bin/carbonio-preview-bin"
  install -Dm755 "${srcdir}/libpdfium.so" \
    "${pkgdir}/usr/lib/carbonio-preview/libpdfium.so"
  install -Dm644 "${srcdir}/carbonio-preview.service" \
    "${pkgdir}/lib/systemd/system/carbonio-preview.service"
  install -Dm644 "${srcdir}/carbonio-preview.hcl" \
    "${pkgdir}/etc/zextras/service-discover/carbonio-preview.hcl"
  install -Dm755 "${srcdir}/531-carbonio-preview.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/531-carbonio-preview.sh"
  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/preview/service-discover/intentions.json"
  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/preview/service-discover/policies.json"
  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/preview/service-discover/service-protocol.json"
  install -Dm644 "${srcdir}/messages.ini" \
    "${pkgdir}/etc/carbonio/preview/messages.ini"
  install -Ddm755 "${pkgdir}/var/log/carbonio/preview/"
  install -Dm644 "${srcdir}/carbonio-preview-sidecar.service" \
    "${pkgdir}/lib/systemd/system/carbonio-preview-sidecar.service"
}

